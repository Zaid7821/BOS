# Copy this file to server/.env and fill in real values. Never commit server/.env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Set to "true" for hosted Postgres that needs SSL (Neon, Render external URL, etc.)
DATABASE_SSL=false
PORT=5000
# Comma-separated list of site origins allowed to call the API
CORS_ORIGIN=http://localhost:8080
# Password for the /admin dashboard. Use a long random value.
ADMIN_PASSWORD=change-me
# Secret used to sign admin login tokens. Use a long random value.
ADMIN_TOKEN_SECRET=change-me-too
# Cloudinary account used for photo uploads from the admin panel.
# Find these at cloudinary.com > Dashboard (or Settings > API Keys).
CLOUDINARY_CLOUD_NAME=djfhmzjuz
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
